# 🔥 ACTIVATION HEATMAP VISUALIZATION
# Visualize how the autoencoder internally processes specific digits (0, 1, 8, etc.)

def get_activation_maps(model, input_image):
    """Extract activation maps from different layers of the autoencoder"""
    activation_maps = {}
    
    def hook_fn(name):
        def hook(module, input, output):
            if isinstance(output, torch.Tensor):
                activation_maps[name] = output.detach()
        return hook
    
    # Register hooks on key layers
    hooks = []
    layer_names = []
    
    # Hook encoder layers
    for i, layer in enumerate(model.encoder):
        if hasattr(layer, 'weight'):  # Only hook layers with weights (Conv2d, Linear)
            name = f'encoder_layer_{i}'
            layer_names.append(name)
            hooks.append(layer.register_forward_hook(hook_fn(name)))
    
    # Hook decoder layers if accessible
    if hasattr(model, 'decoder'):
        for i, layer in enumerate(model.decoder):
            if hasattr(layer, 'weight'):
                name = f'decoder_layer_{i}'
                layer_names.append(name)
                hooks.append(layer.register_forward_hook(hook_fn(name)))
    
    # Forward pass to collect activations
    model.eval()
    with torch.no_grad():
        _ = model(input_image)
    
    # Remove hooks
    for hook in hooks:
        hook.remove()
    
    return activation_maps, layer_names

def visualize_digit_activations(model, test_loader, device, target_digits=[0, 1, 8]):
    """Create activation heatmaps for specific digits"""
    
    # Find examples of target digits
    digit_examples = {}
    
    for images, labels in test_loader:
        for digit in target_digits:
            if digit not in digit_examples:
                mask = labels == digit
                if mask.any():
                    digit_examples[digit] = images[mask][0:1]  # Take first example
        
        # Break when we have all digits
        if len(digit_examples) == len(target_digits):
            break
    
    if len(digit_examples) == 0:
        print("❌ No target digits found in test data")
        return
    
    # Create figure
    n_digits = len(digit_examples)
    fig = plt.figure(figsize=(16, 4 * n_digits))
    
    for idx, (digit, image) in enumerate(digit_examples.items()):
        image = image.to(device)
        
        # Get activation maps
        activations, layer_names = get_activation_maps(model, image)
        
        # Select most interesting layers (first few encoder layers)
        interesting_layers = layer_names[:3] if len(layer_names) >= 3 else layer_names
        
        # Create subplot for this digit
        n_cols = len(interesting_layers) + 1  # +1 for original image
        
        # Original image
        plt.subplot(n_digits, n_cols, idx * n_cols + 1)
        plt.imshow(image[0, 0].cpu().numpy(), cmap='gray')
        plt.title(f'Digit {digit}\n(Original)')
        plt.axis('off')
        
        # Activation maps
        for layer_idx, layer_name in enumerate(interesting_layers):
            plt.subplot(n_digits, n_cols, idx * n_cols + layer_idx + 2)
            
            activation = activations[layer_name][0]  # First sample in batch
            
            # Handle different activation shapes
            if len(activation.shape) == 3:  # Conv layer output (C, H, W)
                # Average across channels or take first few channels
                if activation.shape[0] > 1:
                    heatmap = activation.mean(dim=0).cpu().numpy()
                else:
                    heatmap = activation[0].cpu().numpy()
            elif len(activation.shape) == 2:  # Linear layer output (batch, features)
                # Reshape to square-ish for visualization
                feat_size = activation.shape[1]
                side = int(np.sqrt(feat_size))
                if side * side == feat_size:
                    heatmap = activation[0].reshape(side, side).cpu().numpy()
                else:
                    # Pad to make square
                    pad_size = side * side + 2 * side + 1 - feat_size
                    padded = torch.cat([activation[0], torch.zeros(pad_size, device=activation.device)])
                    heatmap = padded.reshape(side + 1, side + 1).cpu().numpy()
            else:
                # Fallback: flatten and reshape
                flat = activation.flatten()
                side = int(np.sqrt(len(flat)))
                heatmap = flat[:side*side].reshape(side, side).cpu().numpy()
            
            # Plot heatmap
            im = plt.imshow(heatmap, cmap='viridis', aspect='auto')
            plt.title(f'{layer_name}\n(Activation)')
            plt.axis('off')
            plt.colorbar(im, fraction=0.046, pad=0.04)
    
    plt.tight_layout()
    plt.suptitle('🔥 Autoencoder Activation Patterns by Digit', fontsize=16, y=0.98)
    plt.show()

def compare_latent_representations(model, test_loader, device, target_digits=[0, 1, 8]):
    """Compare latent space representations of different digits"""
    
    # Collect latent representations
    digit_latents = {digit: [] for digit in target_digits}
    
    model.eval()
    with torch.no_grad():
        for images, labels in test_loader:
            images = images.to(device)
            
            # Get latent representations (assuming model returns them)
            outputs = model(images)
            
            # Extract content latents (assuming they're in a specific output)
            if len(outputs) >= 2:
                content_latents = outputs[1]  # Often the second output
            else:
                # Fallback: encode to get latents
                latents = model.encode(images)
                if isinstance(latents, (list, tuple)):
                    content_latents = latents[0]  # Content part
                else:
                    content_latents = latents
            
            # Group by digit
            for digit in target_digits:
                mask = labels == digit
                if mask.any():
                    digit_latents[digit].extend(content_latents[mask].cpu().numpy())
            
            # Stop when we have enough samples
            if all(len(digit_latents[d]) >= 20 for d in target_digits):
                break
    
    # Convert to arrays
    for digit in target_digits:
        if digit_latents[digit]:
            digit_latents[digit] = np.array(digit_latents[digit][:20])  # Take first 20
    
    # Plot latent space scatter
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))
    
    colors = ['red', 'blue', 'green', 'orange', 'purple']
    
    # Scatter plot in latent space (assuming 2D content latents)
    for i, digit in enumerate(target_digits):
        if len(digit_latents[digit]) > 0:
            latents = digit_latents[digit]
            if latents.shape[1] >= 2:
                ax1.scatter(latents[:, 0], latents[:, 1], 
                           c=colors[i], label=f'Digit {digit}', alpha=0.7, s=50)
    
    ax1.set_xlabel('Content Latent Dim 1')
    ax1.set_ylabel('Content Latent Dim 2')
    ax1.set_title('🎯 Content Latent Space Distribution')
    ax1.legend()
    ax1.grid(True, alpha=0.3)
    
    # Heatmap of average latent values
    latent_matrix = []
    digit_labels = []
    
    for digit in target_digits:
        if len(digit_latents[digit]) > 0:
            avg_latent = np.mean(digit_latents[digit], axis=0)
            latent_matrix.append(avg_latent)
            digit_labels.append(f'Digit {digit}')
    
    if latent_matrix:
        latent_matrix = np.array(latent_matrix)
        im = ax2.imshow(latent_matrix, cmap='RdBu_r', aspect='auto')
        ax2.set_yticks(range(len(digit_labels)))
        ax2.set_yticklabels(digit_labels)
        ax2.set_xlabel('Latent Dimension')
        ax2.set_title('🌡️ Average Latent Values')
        plt.colorbar(im, ax=ax2)
    
    plt.tight_layout()
    plt.show()
    
    return digit_latents

if model_loaded:
